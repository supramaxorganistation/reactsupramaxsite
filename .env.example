# Copiez ce fichier en `.env` à la racine et renseignez vos vraies valeurs.
# Ce fichier est lu par Vite (variables VITE_*), par `netlify dev` (toutes les
# variables, injectées dans les fonctions netlify/functions/*), et par
# server/index.js via dotenv lorsqu'il est lancé depuis la racine du projet.

# --- Chatbot (netlify/functions/chatbot.js, server/index.js) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Formulaire de contact (netlify/functions/verify-recaptcha.js, submit-form.js) ---
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
WEB3FORMS_KEY=your_web3forms_key_here

# --- Serveur Express local (npm run dev:server) ---
SERVER_PORT=4000

# --- Variables exposées côté client (Vite) ---
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
VITE_WEB3FORMS_KEY=your_web3forms_key_here
